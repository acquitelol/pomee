use std/prelude;
use std/raylib;
global pub;

enum Config {
    TargetY = 700,
    MaxHitOffset = 150,
}

enum Layout {
    FadeOutTime = 1000,
    LaneWidth = 100,
    LaneHeight = 20,
    ComboY = 100,
    ButtonPadding = 80
}

enum FontSize {
    Judgement = 20,
    Combo = 40,
    Title = 80,
    Subtitle = 40,
    ButtonText = 30
}

enum Screen {
    Width = 600,
    Height = 800
}

enum Judgement {
    Perfect = 60,
    Great = 100,
    Good = 150,
    Bad
}

fn get_judgement_info(i32 offset) {
    abs := math::abs(offset);
    if abs <= Judgement::Perfect { return $$("PERFECT", PINK, SKYBLUE); }
    if abs <= Judgement::Great { return $$("GREAT", VIOLET, VIOLET); }
    if abs <= Judgement::Good { return $$("GOOD", SKYBLUE, SKYBLUE); }
    return $$("BAD", RED, RED);
}

let LANE_KEYS = [
    KeyboardKey::KEY_D,
    KeyboardKey::KEY_F,
    KeyboardKey::KEY_J,
    KeyboardKey::KEY_K
];
