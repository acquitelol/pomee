use std/prelude;
global pub;

enum NoteType {
    Single,
    Hold
}

struct Note {
    NoteType type,
    i32 offset,
    i32 lane,
    i32 hit_offset,
    i32 hit_time,
    i32 duration,   // if NoteType == Hold
    bool fulfilled, // if NoteType == Hold
    bool hit,
}

fn NoteType::from<T>(T x) {
    return #cast(NoteType, #cast(i32, x));
}

fn Note::from_json(JsonValue res) {
    type := NoteType::from(res["type"].as_number());
    
    if type == NoteType::Hold {
        $assert(res.as_object().contains_key("duration"));
    }
    
    return Note {
        type,
        offset = res["offset"].as_number(),
        lane = res["lane"].as_number(),
        hit_offset = 0,
        hit_time = 0,
        duration = type == NoteType::Hold ? res["duration"].as_number() : 0,
        fulfilled = false,
        hit = false,
    };
}
