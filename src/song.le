use std/raylib;

use note;
global pub;

struct Song {
    string readable_name,
    string name,
    Music music,
    Note[] notes,
    i32 speed,
}

fn Song::new(string readable_name, string name) {
    res := io::read_to_string("charts/{}.json".format(name)).parse_json().unwrap();

    return Song {
        readable_name,
        name,
        music = rl::load_music_stream("music/{}.wav".format(name)),
        notes = res["notes"].as_array().map(Note::from_json),
        speed = res["speed"].as_number()
    };
}
