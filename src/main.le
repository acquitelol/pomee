use std/prelude;
use std/raylib;

use state;
use util;
use button;

fn main() {
    rl::init_window(Screen::Width, Screen::Height, "Pomee");
    defer rl::close_window();

    rl::init_audio_device();
    defer rl::close_audio_device();

    rl::set_target_fps(60);

    state := State {
        state = StateKind::Menu,
        songs = [
            Song::new("Quiet Meadow", "meow2.1"),
            Song::new("Floating Away", "floating_away_on_a_cloud2"),
            Song::new("Petal Rush", "fast6.1"),
        ],
        target = rl::load_render_texture(Screen::Width, Screen::Height),
        click = rl::load_sound("sfx/hit.wav"),
        combo = 0,
        time = 0,
    };

    defer rl::unload_render_texture(state.target);
    defer rl::unload_sound(state.click);
    defer for song in state.songs {
        rl::unload_music_stream(song.music);
    };

    rl::set_sound_volume(state.click, 0.1);

    while !rl::window_should_close() {
        state.update_music();
        state.handle_inputs();

        rl::begin_drawing();
        rl::clear_background(BLACK);

        if state.state == StateKind::Menu {
            state.draw_menu();
        } else {
            state.draw_judgement_line();
            state.draw_notes();
            state.draw_judgements();
            state.draw_combo();
        }

        rl::draw_fps(8, 8);
        rl::end_drawing();
    }
}
